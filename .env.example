# =========================================================
#  Ezan Plus Sosyal Medya Botu — Ortam Değişkenleri
#  Bu dosyayı .env olarak kopyalayıp kendi anahtarlarınızı girin.
# =========================================================

# --- Google Gemini AI (İçerik, Ayet Meali, Tefekkür & Caption Üretimi) ---
GEMINI_API_KEY=""

# --- Telegram Bot (Onay Grubu ve Önizleme) ---
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Instagram Graph API & Reels ---
# Meta for Developers (developers.facebook.com) üzerinden alınır
INSTAGRAM_ACCOUNT_ID=""
INSTAGRAM_ACCESS_TOKEN=""

# --- Meta Threads API (Opsiyonel) ---
THREADS_USER_ID=""
THREADS_ACCESS_TOKEN=""

# --- TikTok API (Opsiyonel) ---
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_REFRESH_TOKEN=""

# --- Görsel Barındırma (Instagram Graph API için public URL zorunludur) ---
IMGBB_API_KEY=""

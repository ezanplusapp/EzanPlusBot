ation":{"text":"walaw"}},{"char_type_name":"word","text_uthmani":"كَرِهَ","location":"61:8:10","transliteration":{"text":"kariha"}},{"char_type_name":"word","text_uthmani":"ٱلْكَـٰفِرُونَ","location":"61:8:11","transliteration":{"text":"l-kāfirūna"}},{"char_type_name":"end","text_uthmani":"٨","location":"61:8:12","transliteration":{"text":null}}],"translation":"Ağızlarıyla Allah'ın nurunu söndürmek isterler. İnkarcılar ne kadar istemeseler de, Allah nurunu, dinini tamamlayacaktır.","transliteration":"yurīdūna liyuṭ'fiū nūra l-lahi bi-afwāhihim wal-lahu mutimmu nūrihi walaw kariha l-kāfirūna"},{"id":5172,"verse_key":"61:9","verse_number":9,"words":[{"char_type_name":"word","text_uthmani":"هُوَ","location":"61:9:1","transliteration":{"text":"huwa"}},{"char_type_name":"word","text_uthmani":"ٱلَّذِىٓ","location":"61:9:2","transliteration":{"text":"alladhī"}},{"char_type_name":"word","text_uthmani":"أَرْسَلَ","location":"61:9:3","transliteration":{"text":"arsala"}},{"char_type_name":"word","text_uthmani":"رَسُولَهُۥ","location":"61:9:4","transliteration":{"text":"rasūlahu"}},{"char_type_name":"word","text_uthmani":"بِٱلْهُدَىٰ","location":"61:9:5","transliteration":{"text":"bil-hudā"}},{"char_type_name":"word","text_uthmani":"وَدِينِ","location":"61:9:6","transliteration":{"text":"wadīni"}},{"char_type_name":"word","text_uthmani":"ٱلْحَقِّ","location":"61:9:7","transliteration":{"text":"l-ḥaqi"}},{"char_type_name":"word","text_uthmani":"لِيُظْهِرَهُۥ","location":"61:9:8","transliteration":{"text":"liyuẓ'hirahu"}},{"char_type_name":"word","text_uthmani":"عَلَى","location":"61:9:9","transliteration":{"text":"ʿalā"}},{"char_type_name":"word","text_uthmani":"ٱلدِّينِ","location":"61:9:10","transliteration":{"text":"l-dīni"}},{"char_type_name":"word","text_uthmani":"كُلِّهِۦ","location":"61:9:11","transliteration":{"text":"kullihi"}},{"char_type_name":"word","text_uthmani":"وَلَوْ","location":"61:9:12","transliteration":{"text":"walaw"}},{"char_type_name":"word","text_uthmani
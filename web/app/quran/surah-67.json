pe_name":"end","text_uthmani":"١٣","location":"67:13:10","transliteration":{"text":null}}],"translation":"Sizler, sözlerinizi gizleseniz de açıklasanız da birdir; O, kalblerde olanı bilir.","transliteration":"wa-asirrū qawlakum awi ij'harū bihi innahu ʿalīmun bidhāti l-ṣudūri"},{"id":5255,"verse_key":"67:14","verse_number":14,"words":[{"char_type_name":"word","text_uthmani":"أَلَا","location":"67:14:1","transliteration":{"text":"alā"}},{"char_type_name":"word","text_uthmani":"يَعْلَمُ","location":"67:14:2","transliteration":{"text":"yaʿlamu"}},{"char_type_name":"word","text_uthmani":"مَنْ","location":"67:14:3","transliteration":{"text":"man"}},{"char_type_name":"word","text_uthmani":"خَلَقَ","location":"67:14:4","transliteration":{"text":"khalaqa"}},{"char_type_name":"word","text_uthmani":"وَهُوَ","location":"67:14:5","transliteration":{"text":"wahuwa"}},{"char_type_name":"word","text_uthmani":"ٱللَّطِيفُ","location":"67:14:6","transliteration":{"text":"l-laṭīfu"}},{"char_type_name":"word","text_uthmani":"ٱلْخَبِيرُ","location":"67:14:7","transliteration":{"text":"l-khabīru"}},{"char_type_name":"end","text_uthmani":"١٤","location":"67:14:8","transliteration":{"text":null}}],"translation":"Yaratan bilmez olur mu? O, Latif'tir, haberdardır.","transliteration":"alā yaʿlamu man khalaqa wahuwa l-laṭīfu l-khabīru"},{"id":5256,"verse_key":"67:15","verse_number":15,"words":[{"char_type_name":"word","text_uthmani":"هُوَ","location":"67:15:1","transliteration":{"text":"huwa"}},{"char_type_name":"word","text_uthmani":"ٱلَّذِى","location":"67:15:2","transliteration":{"text":"alladhī"}},{"char_type_name":"word","text_uthmani":"جَعَلَ","location":"67:15:3","transliteration":{"text":"jaʿala"}},{"char_type_name":"word","text_uthmani":"لَكُمُ","location":"67:15:4","transliteration":{"text":"lakumu"}},{"char_type_name":"word","text_uthmani":"ٱلْأَرْضَ","location":"67:15:5","transliteration":{"text":"l-arḍa"}},{"char_type_name":"word","text_uthmani":"ذَلُولًۭا","location":"67:15:6","t
 fa-ulāika humu l-muf'liḥūna"},{"id":5216,"verse_key":"64:17","verse_number":17,"words":[{"char_type_name":"word","text_uthmani":"إِن","location":"64:17:1","transliteration":{"text":"in"}},{"char_type_name":"word","text_uthmani":"تُقْرِضُوا۟","location":"64:17:2","transliteration":{"text":"tuq'riḍū"}},{"char_type_name":"word","text_uthmani":"ٱللَّهَ","location":"64:17:3","transliteration":{"text":"l-laha"}},{"char_type_name":"word","text_uthmani":"قَرْضًا","location":"64:17:4","transliteration":{"text":"qarḍan"}},{"char_type_name":"word","text_uthmani":"حَسَنًۭا","location":"64:17:5","transliteration":{"text":"ḥasanan"}},{"char_type_name":"word","text_uthmani":"يُضَـٰعِفْهُ","location":"64:17:6","transliteration":{"text":"yuḍāʿif'hu"}},{"char_type_name":"word","text_uthmani":"لَكُمْ","location":"64:17:7","transliteration":{"text":"lakum"}},{"char_type_name":"word","text_uthmani":"وَيَغْفِرْ","location":"64:17:8","transliteration":{"text":"wayaghfir"}},{"char_type_name":"word","text_uthmani":"لَكُمْ ۚ","location":"64:17:9","transliteration":{"text":"lakum"}},{"char_type_name":"word","text_uthmani":"وَٱللَّهُ","location":"64:17:10","transliteration":{"text":"wal-lahu"}},{"char_type_name":"word","text_uthmani":"شَكُورٌ","location":"64:17:11","transliteration":{"text":"shakūrun"}},{"char_type_name":"word","text_uthmani":"حَلِيمٌ","location":"64:17:12","transliteration":{"text":"ḥalīmun"}},{"char_type_name":"end","text_uthmani":"١٧","location":"64:17:13","transliteration":{"text":null}}],"translation":"Eğer Allah'a güzel bir ödünç takdiminde bulunursanız, onu sizin için kat kat yapar ve sizi bağışlar; Allah, şükrün karşılığını verendir; Halim'dir.","transliteration":"in tuq'riḍū l-laha qarḍan ḥasanan yuḍāʿif'hu lakum wayaghfir lakum wal-lahu shakūrun ḥalīmun"},{"id":5217,"verse_key":"64:18","verse_number":18,"words":[{"char_type_name":"word","text_uthmani":"عَـٰلِمُ","location":"64:18:1","transliteration":{"text":"ʿālimu"}},{"char_type_name":"word","text_uthmani":"ٱلْغَيْبِ","location":"64:18:2","transliteration":{"text":"l-ghaybi"}},{"char_type_name":"word","text_uthmani":"وَٱلشَّهَـٰدَةِ","location":"64:18:3","transliteration":{"text":"wal-shahādati"}},{"char_type_name":"word","text_uthmani":"ٱلْعَزِيزُ","location":"64:18:4","transliteration":{"text":"l-ʿazīzu"}},{"char_type_name":"word","text_uthmani":"ٱلْحَكِيمُ","location":"64:18:5","transliteration":{"text":"l-ḥakīmu"}},{"char_type_name":"end","text_uthmani":"١٨","location":"64:18:6","transliteration":{"text":null}}],"translation":"Görüleni görülmeyeni bilendir, güçlüdür. Hakim'dir.","transliteration":"ʿālimu l-ghaybi wal-shahādati l-ʿazīzu l-ḥakīmu"}]}
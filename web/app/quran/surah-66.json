na"},{"id":5236,"verse_key":"66:7","verse_number":7,"words":[{"char_type_name":"word","text_uthmani":"يَـٰٓأَيُّهَا","location":"66:7:1","transliteration":{"text":"yāayyuhā"}},{"char_type_name":"word","text_uthmani":"ٱلَّذِينَ","location":"66:7:2","transliteration":{"text":"alladhīna"}},{"char_type_name":"word","text_uthmani":"كَفَرُوا۟","location":"66:7:3","transliteration":{"text":"kafarū"}},{"char_type_name":"word","text_uthmani":"لَا","location":"66:7:4","transliteration":{"text":"lā"}},{"char_type_name":"word","text_uthmani":"تَعْتَذِرُوا۟","location":"66:7:5","transliteration":{"text":"taʿtadhirū"}},{"char_type_name":"word","text_uthmani":"ٱلْيَوْمَ ۖ","location":"66:7:6","transliteration":{"text":"l-yawma"}},{"char_type_name":"word","text_uthmani":"إِنَّمَا","location":"66:7:7","transliteration":{"text":"innamā"}},{"char_type_name":"word","text_uthmani":"تُجْزَوْنَ","location":"66:7:8","transliteration":{"text":"tuj'zawna"}},{"char_type_name":"word","text_uthmani":"مَا","location":"66:7:9","transliteration":{"text":"mā"}},{"char_type_name":"word","text_uthmani":"كُنتُمْ","location":"66:7:10","transliteration":{"text":"kuntum"}},{"char_type_name":"word","text_uthmani":"تَعْمَلُونَ","location":"66:7:11","transliteration":{"text":"taʿmalūna"}},{"char_type_name":"end","text_uthmani":"٧","location":"66:7:12","transliteration":{"text":null}}],"translation":"\"Ey inkar edenler! Bugün özür beyan etmeyin, ancak işlediklerinizin karşılığını görmektesiniz\" denir.","transliteration":"yāayyuhā alladhīna kafarū lā taʿtadhirū l-yawma innamā tuj'zawna mā kuntum taʿmalūna"},{"id":5237,"verse_key":"66:8","verse_number":8,"words":[{"char_type_name":"word","text_uthmani":"يَـٰٓأَيُّهَا","location":"66:8:1","transliteration":{"text":"yāayyuhā"}},{"char_type_name":"word","text_uthmani":"ٱلَّذِينَ","location":"66:8:2","transliteration":{"text":"alladhīna"}},{"char_type_name":"word","text_uthmani":"ءَامَنُوا۟","location":"66:8:3","transliteration":{"text":"āmanū"}},{"char_type_name
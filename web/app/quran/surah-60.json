n":"yāayyuhā alladhīna āmanū lā tattakhidhū ʿaduwwī waʿaduwwakum awliyāa tul'qūna ilayhim bil-mawadati waqad kafarū bimā jāakum mina l-ḥaqi yukh'rijūna l-rasūla wa-iyyākum an tu'minū bil-lahi rabbikum in kuntum kharajtum jihādan fī sabīlī wa-ib'tighāa marḍātī tusirrūna ilayhim bil-mawadati wa-anā aʿlamu bimā akhfaytum wamā aʿlantum waman yafʿalhu minkum faqad ḍalla sawāa l-sabīli"},{"id":5152,"verse_key":"60:2","verse_number":2,"words":[{"char_type_name":"word","text_uthmani":"إِن","location":"60:2:1","transliteration":{"text":"in"}},{"char_type_name":"word","text_uthmani":"يَثْقَفُوكُمْ","location":"60:2:2","transliteration":{"text":"yathqafūkum"}},{"char_type_name":"word","text_uthmani":"يَكُونُوا۟","location":"60:2:3","transliteration":{"text":"yakūnū"}},{"char_type_name":"word","text_uthmani":"لَكُمْ","location":"60:2:4","transliteration":{"text":"lakum"}},{"char_type_name":"word","text_uthmani":"أَعْدَآءًۭ","location":"60:2:5","transliteration":{"text":"aʿdāan"}},{"char_type_name":"word","text_uthmani":"وَيَبْسُطُوٓا۟","location":"60:2:6","transliteration":{"text":"wayabsuṭū"}},{"char_type_name":"word","text_uthmani":"إِلَيْكُمْ","location":"60:2:7","transliteration":{"text":"ilaykum"}},{"char_type_name":"word","text_uthmani":"أَيْدِيَهُمْ","location":"60:2:8","transliteration":{"text":"aydiyahum"}},{"char_type_name":"word","text_uthmani":"وَأَلْسِنَتَهُم","location":"60:2:9","transliteration":{"text":"wa-alsinatahum"}},{"char_type_name":"word","text_uthmani":"بِٱلسُّوٓءِ","location":"60:2:10","transliteration":{"text":"bil-sūi"}},{"char_type_name":"word","text_uthmani":"وَوَدُّوا۟","location":"60:2:11","transliteration":{"text":"wawaddū"}},{"char_type_name":"word","text_uthmani":"لَوْ","location":"60:2:12","transliteration":{"text":"law"}},{"char_type_name":"word","text_uthmani":"تَكْفُرُونَ","location":"60:2:13","transliteration":{"text":"takfurūna"}},{"char_type_name":"end","text_uthmani":"٢","location":"60:2:14","transliteration":{"text":null}}],"translati
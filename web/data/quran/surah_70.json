ُ","t":"şşerru","s":1.35,"e":2.16},{"w":"جَزُوعًا","t":"cezû'â.","s":2.16,"e":3.75}],"segments":[[0,0.0,0.59],[1,0.59,1.35],[2,1.35,2.16],[3,2.16,3.75]]},{"a":21,"c":29,"ar":"وَإِذَا مَسَّهُ ٱلْخَيْرُ مَنُوعًا","ok":"veizâ messehü-lhayru menû'â.","diy":"Bir iyiliğe uğrarsa onu herkesten meneder;","elm":"Kendisine hayır dokundu mu cimrilik eder.","audio":"https://everyayah.com/data/Alafasy_128kbps/070021.mp3","words":[{"w":"وَإِذَا","t":"veizâ","s":0.0,"e":0.85},{"w":"مَسَّهُ","t":"messehü","s":0.85,"e":1.61},{"w":"ٱلْخَيْرُ","t":"lhayru","s":1.61,"e":2.46},{"w":"مَنُوعًا","t":"menû'â.","s":2.46,"e":3.92}],"segments":[[0,0.0,0.85],[1,0.85,1.61],[2,1.61,2.46],[3,2.46,3.92]]},{"a":22,"c":29,"ar":"إِلَّا ٱلْمُصَلِّينَ","ok":"ille-lmüsallîn.","diy":"Ancak namaz kılıp namazlarında yoksul ve yoksuna belirli bir hak tanıyanlar, ceza gününü doğrulayanlar, Rablerinin azabından korkanlar böyle değildir.","elm":"Ancak namaz kılanlar bunun dışındadır.","audio":"https://everyayah.com/data/Alafasy_128kbps/070022.mp3","words":[{"w":"إِلَّا","t":"ille","s":0.0,"e":0.53},{"w":"ٱلْمُصَلِّينَ","t":"lmüsallîn.","s":0.53,"e":3.77}],"segments":[[0,0.0,0.53],[1,0.53,3.77]]},{"a":23,"c":29,"ar":"ٱلَّذِينَ هُمْ عَلَىٰ صَلَاتِهِمْ دَآئِمُونَ","ok":"ellezîne hüm 'alâ salâtihim dâimûn.","diy":"Ancak namaz kılıp namazlarında yoksul ve yoksuna belirli bir hak tanıyanlar, ceza gününü doğrulayanlar, Rablerinin azabından korkanlar böyle değildir.","elm":"Onlar ki namazlarını sürekli kılarlar.","audio":"https://everyayah.com/data/Alafasy_128kbps/070023.mp3","words":[{"w":"ٱلَّذِينَ","t":"ellezîne","s":0.0,"e":1.22},{"w":"هُمْ","t":"hüm","s":1.22,"e":1.56},{"w":"عَلَىٰ","t":"'alâ","s":1.56,"e":2.05},{"w":"صَلَاتِهِمْ","t":"salâtihim","s":2.05,"e":3.43},{"w":"دَآئِمُونَ","t":"dâimûn.","s":3.43,"e":7.89}],"segments":[[0,0.0,1.22],[1,1.22,1.56],[2,1.56,2.05],[3,2.05,3.43],[4,3.43,7.89]]},{"a":24,"c":29,"ar":"وَٱلَّذِينَ فِىٓ أَمْوَٰلِهِمْ حَقٌّ مَّعْلُومٌ","ok":"vellezîne fî emvâlihim hakkum ma'lûm.","
[{"a":1,"c":30,"ar":"وَيْلٌ لِّلْمُطَفِّفِينَ","ok":"veylül lilmütaffifîn.","diy":"İnsanlardan, kendileri bir şeyi ölçerek aldıkları zaman tam alan; ama onlara bir şeyi ölçüp tartarak verdiklerinde eksik tutan kimselerin, vay haline!","elm":"Eksik ölçüp tartanların vay haline!","audio":"https://everyayah.com/data/Alafasy_128kbps/083001.mp3","words":[{"w":"وَيْلٌ","t":"veylül","s":0.0,"e":0.8},{"w":"لِّلْمُطَفِّفِينَ","t":"lilmütaffifîn.","s":0.8,"e":4.75}],"segments":[[0,0.0,0.8],[1,0.8,4.75]]},{"a":2,"c":30,"ar":"ٱلَّذِينَ إِذَا ٱكْتَالُوا عَلَى ٱلنَّاسِ يَسْتَوْفُونَ","ok":"ellezîne ize-ktâlû 'ale-nnâsi yestevfûn.","diy":"İnsanlardan, kendileri bir şeyi ölçerek aldıkları zaman tam alan; ama onlara bir şeyi ölçüp tartarak verdiklerinde eksik tutan kimselerin, vay haline!","elm":"Onlar insanlardan kendilerine bir şey aldıkları zaman tam ölçerler.","audio":"https://everyayah.com/data/Alafasy_128kbps/083002.mp3","words":[{"w":"ٱلَّذِينَ","t":"ellezîne","s":0.0,"e":1.22},{"w":"إِذَا","t":"ize","s":1.22,"e":1.62},{"w":"ٱكْتَالُوا","t":"ktâlû","s":1.62,"e":2.62},{"w":"عَلَى","t":"'ale","s":2.62,"e":3.01},{"w":"ٱلنَّاسِ","t":"nnâsi","s":3.01,"e":4.74},{"w":"يَسْتَوْفُونَ","t":"yestevfûn.","s":4.74,"e":7.95}],"segments":[[0,0.0,1.22],[1,1.22,1.62],[2,1.62,2.62],[3,2.62,3.01],[4,3.01,4.74],[5,4.74,7.95]]},{"a":3,"c":30,"ar":"وَإِذَا كَالُوهُمْ أَو وَّزَنُوهُمْ يُخْسِرُونَ","ok":"veizâ kâlûhüm ev vezenûhüm yuhsirûn.","diy":"İnsanlardan, kendileri bir şeyi ölçerek aldıkları zaman tam alan; ama onlara bir şeyi ölçüp tartarak verdiklerinde eksik tutan kimselerin, vay haline!","elm":"Kendileri başkalarına bir şey ölçtükleri veya tarttıkları zaman eksik ölçer ve tartarlar.","audio":"https://everyayah.com/data/Alafasy_128kbps/083003.mp3","words":[{"w":"وَإِذَا","t":"veizâ","s":0.0,"e":0.91},{"w":"كَالُوهُمْ","t":"kâlûhüm","s":0.91,"e":2.21},{"w":"أَو","t":"ev","s":2.21,"e":2.5},{"w":"وَّزَنُوهُمْ","t":"vezenûhüm","s":2.5,"e":3.75},{"w":"يُخْسِرُونَ","t":"yuhsirûn.","s":3.75,"e":6.
.com/data/Alafasy_128kbps/053032.mp3","words":[{"w":"ٱلَّذِينَ","t":"ellezîne","s":0.0,"e":1.25},{"w":"يَجْتَنِبُونَ","t":"yectenibûne","s":1.25,"e":2.8},{"w":"كَبَـٰٓئِرَ","t":"kebâira","s":2.8,"e":5.48},{"w":"ٱلْإِثْمِ","t":"l'ismi","s":5.48,"e":6.47},{"w":"وَٱلْفَوَٰحِشَ","t":"velfevâhişe","s":6.47,"e":8.16},{"w":"إِلَّا","t":"ille","s":8.16,"e":8.69},{"w":"ٱللَّمَمَ","t":"llemem.","s":8.69,"e":10.23},{"w":"إِنَّ","t":"inne","s":10.23,"e":11.42},{"w":"رَبَّكَ","t":"rabbeke","s":11.42,"e":12.44},{"w":"وَٰسِعُ","t":"vâsi'u","s":12.44,"e":13.25},{"w":"ٱلْمَغْفِرَةِ","t":"lmagfirah.","s":13.25,"e":15.12},{"w":"هُوَ","t":"hüve","s":15.12,"e":15.46},{"w":"أَعْلَمُ","t":"a'lemü","s":15.46,"e":16.43},{"w":"بِكُمْ","t":"biküm","s":16.43,"e":17.12},{"w":"إِذْ","t":"iz","s":17.12,"e":17.52},{"w":"أَنشَأَكُم","t":"enşeeküm","s":17.52,"e":19.29},{"w":"مِّنَ","t":"mine","s":19.29,"e":20.32},{"w":"ٱلْأَرْضِ","t":"l'ardi","s":20.32,"e":21.34},{"w":"وَإِذْ","t":"veiz","s":21.34,"e":21.95},{"w":"أَنتُمْ","t":"entüm","s":21.95,"e":23.55},{"w":"أَجِنَّةٌ","t":"ecinnetün","s":23.55,"e":25.68},{"w":"فِى","t":"fî","s":25.68,"e":26.52},{"w":"بُطُونِ","t":"bütûni","s":26.52,"e":27.46},{"w":"أُمَّهَـٰتِكُمْ","t":"ümmehâtiküm.","s":27.46,"e":30.55},{"w":"فَلَا","t":"felâ","s":30.55,"e":31.19},{"w":"تُزَكُّوٓا","t":"tüzekkû","s":31.19,"e":34.26},{"w":"أَنفُسَكُمْ","t":"enfüseküm.","s":34.26,"e":36.74},{"w":"هُوَ","t":"hüve","s":36.74,"e":37.08},{"w":"أَعْلَمُ","t":"a'lemü","s":37.08,"e":38.07},{"w":"بِمَنِ","t":"bimeni","s":38.07,"e":38.74},{"w":"ٱتَّقَىٰٓ","t":"ttekâ.","s":38.74,"e":40.22}],"segments":[[0,0.0,1.25],[1,1.25,2.8],[2,2.8,5.48],[3,5.48,6.47],[4,6.47,8.16],[5,8.16,8.69],[6,8.69,10.23],[7,10.23,11.42],[8,11.42,12.44],[9,12.44,13.25],[10,13.25,15.12],[11,15.12,15.46],[12,15.46,16.43],[13,16.43,17.12],[14,17.12,17.52],[15,17.52,19.29],[16,19.29,20.32],[17,20.32,21.34],[18,21.34,21.95],[19,21.95,23.55],[20,23.55,25.68],[21,25.68,26.52],[22,26.52,27.46],[23,27.46,30.55],[24,30.55,31
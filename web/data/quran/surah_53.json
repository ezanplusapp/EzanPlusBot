id 'am men tevellâ 'an zikrinâ velem yürid ille-lhayâte-ddünyâ.","diy":"Bizi anmaktan yüz çevirenlere ve dünya hayatından başka bir şey istemeyenlere aldırma.","elm":"Onun için bizi anmaktan yüz çeviren ve dünya hayatından başka bir şey istemeyenlerden yüz çevir.","audio":"https://everyayah.com/data/Alafasy_128kbps/053029.mp3","words":[{"w":"فَأَعْرِضْ","t":"fea'rid","s":0.0,"e":1.08},{"w":"عَن","t":"'am","s":1.08,"e":1.37},{"w":"مَّن","t":"men","s":1.37,"e":2.9},{"w":"تَوَلَّىٰ","t":"tevellâ","s":2.9,"e":4.05},{"w":"عَن","t":"'an","s":4.05,"e":5.08},{"w":"ذِكْرِنَا","t":"zikrinâ","s":5.08,"e":6.19},{"w":"وَلَمْ","t":"velem","s":6.19,"e":6.87},{"w":"يُرِدْ","t":"yürid","s":6.87,"e":7.56},{"w":"إِلَّا","t":"ille","s":7.56,"e":8.16},{"w":"ٱلْحَيَوٰةَ","t":"lhayâte","s":8.16,"e":9.31},{"w":"ٱلدُّنْيَا","t":"ddünyâ.","s":9.31,"e":10.54}],"segments":[[0,0.0,1.08],[1,1.08,1.37],[2,1.37,2.9],[3,2.9,4.05],[4,4.05,5.08],[5,5.08,6.19],[6,6.19,6.87],[7,6.87,7.56],[8,7.56,8.16],[9,8.16,9.31],[10,9.31,10.54]]},{"a":30,"c":27,"ar":"ذَٰلِكَ مَبْلَغُهُم مِّنَ ٱلْعِلْمِ إِنَّ رَبَّكَ هُوَ أَعْلَمُ بِمَن ضَلَّ عَن سَبِيلِهِ وَهُوَ أَعْلَمُ بِمَنِ ٱهْتَدَىٰ","ok":"zâlike mebleguhüm mine-l'ilm. inne rabbeke hüve a'lemü bimen dalle 'an sebîlihî vehüve a'lemü bimeni-htedâ.","diy":"Bu onların ulaştıkları bilginin seviyesini gösterir. Doğrusu Rabbin yolundan sapmış olanı pek iyi bilir, doğru yolda olanı da çok iyi bilir.","elm":"İşte onların ilimden erişebilecekleri (son sınır) budur. Şüphesiz, Rabbin, yolundan sapanı da iyi bilir; O, hidayette olanı da iyi bilir.","audio":"https://everyayah.com/data/Alafasy_128kbps/053030.mp3","words":[{"w":"ذَٰلِكَ","t":"zâlike","s":0.0,"e":0.93},{"w":"مَبْلَغُهُم","t":"mebleguhüm","s":0.93,"e":2.18},{"w":"مِّنَ","t":"mine","s":2.18,"e":3.41},{"w":"ٱلْعِلْمِ","t":"l'ilm.","s":3.41,"e":4.7},{"w":"إِنَّ","t":"inne","s":4.7,"e":5.69},{"w":"رَبَّكَ","t":"rabbeke","s":5.69,"e":6.64},{"w":"هُوَ","t":"hüve","s":6.64,"e":6.96},{"w":"أَعْلَمُ","t":"a'lemü","s":6.96,"e":7.98},{"w":"بِمَن","t":"bimen","s":7.98,"e":9.2},{"w":"ضَلَّ","t":"dalle","s":9.2,"e":9.85},{"w":"عَن","t":"'an","s":9.85,"e":10.79},{"w":"سَبِيلِهِ","t":"sebîlihî","s":10.79,"e":12.2},{"w":"وَهُوَ","t":"vehüve","s":12.2,"e":12.88},{"w":"أَعْلَمُ","t":"a'lemü","s":12.88,"e":13.83},{"w":"بِمَنِ","t":"bimeni","s":13.83,"e":14.51},{"w":"ٱهْتَدَىٰ","t":"htedâ.","s":14.51,"e":15.56}],"segments":[[0,0.0,0.93],[1,0.93,2.18],[2,2.18,3.41],[3,3.41,4.7],[4,4.7,5.69],[5,5.69,6.64],[6,6.64,6.96],[7,6.96,7.98],[8,7.98,9.2],[9,9.2,9.85],[10,9.85,10.79],[11,10.79,12.2],[12,12.2,12.88],[13,12.88,13.83],[14,13.83,14.51],[15,14.51,15.56]]},{"a":31,"c":27,"ar":"وَلِلَّهِ مَا فِى ٱلسَّمَـٰوَٰتِ وَمَا فِى ٱلْأَرْضِ لِيَجْزِىَ ٱلَّذِينَ أَسَـٰٓـُٔوا بِمَا عَمِلُوا وَيَجْزِىَ ٱلَّذِينَ أَحْسَنُوا بِٱلْحُسْنَى","ok":"velillâhi mâ fi-ssemâvâti vemâ fi-l'ardi liyecziye-llezîne esâü bimâ 'amilû veyecziye-llezîne ahsenû bilhusnâ.","diy":"Göklerde olanlar ve yerde olanlar Allah'ındır ki O, kötülük yapanlara işlerinin karşılığını verir; iyi davrananlara, ufak tefek kabahatleri bir yana büyük günahlardan ve hayasızlıklardan kaçınanlara işlediklerinden daha iyisiyle karşılığını verir. Doğrusu Rabbinin bağışı boldur. Sizi yerden var ederken ve siz annelerinizin karınlarında cenin halinde iken sizleri çok iyi bilen O'dur. Kendinizi temize çıkarmayın. O, sakınanı çok iyi bilir.","elm":"Göklerde ve yerde bulunanlar hep Allah'ındır. Akıbet (sonuçta) kötülük yapanları yaptıkları ile cezalandıracak, güzel davrananları da daha güzeliyle mükafatlandıracaktır.","audio":"https://everyayah.com/data/Alafasy_128kbps/053031.mp3","words":[{"w":"وَلِلَّهِ","t":"velillâhi","s":0.0,"e":1.45},{"w":"مَا","t":"mâ","s":1.45,"e":1.82},{"w":"فِى","t":"fi","s":1.82,"e":2.04},{"w":"ٱلسَّمَـٰوَٰتِ","t":"ssemâvâti","s":2.04,"e":3.81},{"w":"وَمَا","t":"vemâ","s":3.81,"e":4.4},{"w":"فِى","t":"fi","s":4.4,"e":4.65},{"w":"ٱلْأَرْضِ","t":"l'ardi","s":4.65,"e":5.62},{"w":"لِيَجْزِىَ","t":"liyecziye","s":5.62,"e":6.71},{"w":"